<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE article [
<!ENTITY % entities SYSTEM "global.ent"> %entities;
]>
<article xml:lang="en"
         xmlns="http://docbook.org/ns/docbook" version="5.0"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:xlink="http://www.w3.org/1999/xlink">
  <info>
    <title>$title$</title>

    $if(subtitle)$
    <subtitle>$subtitle$</subtitle>
    $endif$

    <authorgroup>
      $for(authors)$
      <author>
        $if(authors.name)$
        <personname>$authors.name$</personname>
        $endif$
        $if(authors.firstname)$
        <firstname>$authors.firstname$</firstname>
        $endif$
        $if(authors.surname)$
        <surname>$authors.surname$</surname>
        $endif$
        $if(authors.email)$
        <email>$authors.email$</email>
        $endif$
        $if(authors.affiliation)$
        <affiliation>$authors.affiliation$</affiliation>
        $endif$
      </author>
      $endfor$
    </authorgroup>

    $if(project)$
    <productname>$project$</productname>
    $else$
    $if(product)$
    <productname>$product$</productname>
    $else$
    $if(productname)$
    <productname>$productname$</productname>
    $endif$
    $endif$
    $endif$

    $if(copyright)$
    <copyright>
      <year>$year$</year>
      <holder>$copyright$</holder>
    </copyright>
    $endif$

    $if(legalnotice)$
    <legalnotice><para>$legalnotice$</para></legalnotice>
    $endif$

    $if(date)$
    <date>
      $if(date.day)$
      $date.day$
      $endif$
      $if(date.month)$
      $date.month$
      $endif$
      $if(date.year)$
      $date.year$
      $endif$
    </date>
    <pubdate>
      $if(date.day)$
      $date.day$
      $endif$
      $if(date.month)$
      $date.month$
      $endif$
      $if(date.year)$
      $date.year$
      $endif$
    </pubdate>
    $endif$
  </info>

  $for(include-before)$
  $include-before$
  $endfor$
  $body$
  $for(include-after)$
  $include-after$
  $endfor$
</article>
