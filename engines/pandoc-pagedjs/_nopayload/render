#!/bin/sh
# The conversion, as it runs *inside* the image.
#
#   render <input|-> <output|-> <payload-dir>
#
# The engine contract, honoured in the container. This is what v1's
# convert_to_pdf did, and nothing else that entrypoint.sh did: no argument
# scanning, no directory walking, no up-to-date checking, no watching. Those
# are the wrapper's, and having them here as well is what let v1's CLI drift
# away from the rest of the tool.
#
# Named `render` rather than `convert` to keep the two straight: `convert` is
# the host-side script that starts a container, and this is what that container
# runs. A reader looking at a stack trace should be able to tell which side of
# the boundary they are on.
set -eu

ENGINE=/engine

in=${1:--}
out=${2:--}
payload=${3:-/payload}

# pdfulator-flavoured Markdown: commonmark_x plus implicit_figures.
#
# commonmark_x rather than pandoc's own markdown because it is CommonMark plus
# a curated, NAMED extension set -- so the dialect is a specification someone
# can check a document against rather than "whatever the parser happens to do".
# See DIALECT.md.
#
# What was here before, and why it is gone:
#
#   -raw_html   A no-op. Verified against pandoc 3.1.11.1: output is byte
#               identical with and without it, for inline <b> and for a block
#               <figure> alike. The comment justifying it claimed embedded HTML
#               smuggles in layout the stylesheet cannot control -- a
#               restriction that was never actually in force. Raw HTML is
#               wanted anyway: a caption carrying markup, or two plates under
#               one caption, can only be written that way.
#
#   +task_lists +definition_lists
#               Both are already on by default in commonmark_x. Naming them
#               again said nothing and implied the base set was smaller than
#               it is.
#
# implicit_figures is NOT in the baseline, though pandoc offers it. It wraps
# any lone image, so an image inside a hand-written <figure> gets a second,
# nested one with the caption repeated -- and a caption carrying markup, or two
# plates under one caption, can only be written as raw HTML. Opt in with
# `markdown_features: +implicit_figures`.
PFM_FORMAT=commonmark_x
FORMAT=$PFM_FORMAT

# The template comes from the staged directory, which the wrapper built.
#
# It used to be "the engine's, unless the theme has one", and that was the bug:
# a theme's article.tmpl was staged by *name*, so themes/default's Mustache
# template -- written for the vivlio engines -- was handed to pandoc, which
# does not know that syntax and printed the markup into the PDF as literal
# text. Every shipped theme did this.
#
# The template, ASKED FOR RATHER THAN GUESSED.
#
# The payload names its own structural file in templates/<id>/template.conf,
# and _lib/payload.sh reads it -- the same reader, at the same revision, that
# the wrapper used to assemble the payload, because it travels inside it. That
# replaces looking for a template at an agreed name at the payload root, a leftover
# from when the mounted directory WAS a theme and is the by-name coupling
# that once let a Mustache template reach pandoc.
#
# The engine's own copy stays as the fallback for a bare `docker run` with no
# payload mounted, which is a supported way to use these images: there is no
# _lib/ there and no conf files to read, so the engine falls back to what it
# ships, exactly as the contract says it should.
#
# `if`, not `[ ... ] && ...`. Under `set -e` a bare test that fails is a
# failing command, and if it is the last one in the script -- or anywhere the
# shell is not already ignoring the status -- it exits silently: no message, no
# non-zero status the caller can see a reason for. Three bugs in lib/browser.sh
# were exactly this shape (daf9507).
TEMPLATE=$ENGINE/template.html.pandoc
if [ -x "$payload/_lib/payload.sh" ]; then
	# Relative to the payload, so it is correct at whatever path the payload
	# was mounted at. `|| :` because a payload naming no template is not an
	# error -- it means this engine's built-in, which is what TEMPLATE already
	# holds.
	_markup=$(sh "$payload/_lib/payload.sh" markup "$payload" 2>/dev/null || :)
	if [ -n "$_markup" ] && [ -f "$payload/$_markup" ]; then
		TEMPLATE=$payload/$_markup
	fi
fi

# The stylesheet links, EMITTED ONLY FOR FILES THAT EXIST.
#
# The template used to hardcode three <link>s -- fonts.css, print.css,
# logo.css. All three are generated by the wrapper at the payload root, so they
# are all present whenever a payload is mounted and the hardcoding was
# invisible. A bare `docker run` mounts no payload, gets the image's baked-in
# themes/default, and that directory has none of those three names in it: it
# ships `default.theme.css` and font declarations from which fonts.css would be
# GENERATED. Three <link>s then 404, and pagedjs-cli does not treat a failed
# stylesheet load as cosmetic -- it aborts the render with `ProgressEvent`,
# which names neither the file nor the reason.
#
# So the links are computed here, where the filesystem can actually be
# consulted, and passed in as a repeated pandoc variable. This is what the
# vivlio engine already does in linkTags() -- it guards every link with
# existsSync for exactly this reason -- and the two now behave the same way on
# a payload-less run.
#
# The href is `$payload/...`, the ACTUAL mount path, not a literal `/payload/`.
# pagedjs-cli renders a local file rather than serving over HTTP, so these
# resolve on the container's filesystem; `/payload` is only the default, and the
# third argument can put the payload anywhere.
#
# Order matches §5 and linkTags(): fonts first (it declares the @font-face and
# --pdfulator-<role> properties every later sheet may use), then the cascade,
# then logo.css last. print.css is already the whole cascade concatenated in
# level order by the wrapper, so there is nothing to reconcile here -- which is
# why this needs no `stylesheets` command from _lib/payload.sh, and why that
# command stays absent (see the comment at the top of lib/payload/payload.sh).
CSSVARS=""
for _sheet in fonts.css print.css logo.css; do
	if [ -f "$payload/$_sheet" ]; then
		CSSVARS="$CSSVARS --variable=pdfulator_stylesheet:$payload/$_sheet"
	fi
done

# A bare run has none of those, but it does have the fallback theme's own
# stylesheets un-concatenated. Link them directly so that fallback
# actually styles something, rather than rendering unstyled but succeeding.
if [ -z "$CSSVARS" ]; then
	for _sheet in "$payload"/*.css; do
		[ -f "$_sheet" ] || continue
		CSSVARS="$CSSVARS --variable=pdfulator_stylesheet:$_sheet"
	done
fi

# Both filters run when both exist: the engine's hoists the title and fills in
# the year, and a theme's can add to that rather than having to reimplement it.
FILTERS=""
if [ -f "$ENGINE/metadata.lua" ]; then
	FILTERS="$FILTERS --lua-filter=$ENGINE/metadata.lua"
fi
if [ -f "$payload/metadata.lua" ]; then
	FILTERS="$FILTERS --lua-filter=$payload/metadata.lua"
fi

# Everything happens in a scratch directory, including for a file input.
# Copying the document somewhere private is what makes the read-only input
# mount viable: nothing is written next to the user's document.
WORK=$(mktemp -d /work/pdfulator.XXXXXX)
cleanup() { [ -n "${PDFULATOR_DEBUG:-}" ] || rm -rf "$WORK"; }
trap cleanup EXIT INT TERM

if [ "$in" = "-" ]; then
	cat > "$WORK/doc.md"
	leaf=doc
	# Empty *stdin* is an error; an empty file is not. The asymmetry is
	# deliberate and shared with the vivlio engine: a pipe that produced
	# nothing is a broken command line, while an empty document is a document
	# someone has started and not yet written.
	[ -s "$WORK/doc.md" ] || {
		echo "pandoc-pagedjs: empty input on stdin" >&2
		exit 1
	}
	SOURCE="$WORK/doc.md"
	METADATA=""
else
	[ -f "$in" ] || { echo "pandoc-pagedjs: no such input: $in" >&2; exit 1; }
	leaf=$(basename -- "$in"); leaf=${leaf%.*}
	cp -- "$in" "$WORK/$leaf.md"
	SOURCE="$WORK/$leaf.md"

	# The sidecar, if there is one, as --metadata-file.
	#
	# NOT as a second input file, which is what v1 did and what this first
	# reproduced. Pandoc only reads YAML from an input file when it is fenced
	# with --- and ..., and a sidecar is not: so an unfenced one is parsed as
	# *markdown* and its text lands in the body of the document --
	# "title: My Report authors: name: Tom" printed as a paragraph, with the
	# title unchanged.
	#
	# (An earlier version of this comment went on to say that fencing does not
	# help either, because commonmark_x has no YAML metadata block extension.
	# That is wrong: yaml_metadata_block is ON by default in commonmark_x, and
	# a document's own --- frontmatter is read correctly. The reason to use
	# --metadata-file for a SIDECAR stands -- an unfenced file is not
	# frontmatter and pandoc has no reason to treat it as such.)
	#
	# --metadata-file reads it as what it is, and matches how the vivlio
	# engine treats a sidecar, so the same document gets the same title from
	# either engine.
	METADATA=""
	base=${in%.*}
	for ext in yaml yml; do
		if [ -f "$base.$ext" ]; then
			cp -- "$base.$ext" "$WORK/$leaf.$ext"
			METADATA="--metadata-file=$WORK/$leaf.$ext"
			break
		fi
	done

	# The document's siblings, so that `![](fig.svg)` resolves.
	#
	# The generated HTML lives in $WORK, and pagedjs-cli resolves a relative
	# src against the HTML's own location -- so with only the markdown copied
	# in, every document-relative image silently renders as nothing at all.
	# The vivlio engine had the same bug from the same cause (aa7e38c).
	#
	# Linked rather than copied: a document beside a directory of figures
	# should not cost a copy of all of them per render, and $WORK is scratch
	# that is deleted on exit.
	#
	# NOT the names this script writes. $WORK/$leaf.html and $WORK/$leaf.pdf
	# are its own outputs, and a document sitting beside a previous render's
	# PDF -- the overwhelmingly common case, since that is where output lands
	# by default -- would otherwise get that PDF linked in and then written
	# THROUGH the link into the read-only input mount. EROFS, after a
	# successful render, from a file the user cannot see is involved.
	#
	# Failures are ignored deliberately: a name that cannot be linked is one
	# asset missing from one document, and the rest of it is still worth
	# rendering. Same rule as the vivlio engine, where a missing figure is the
	# author's problem rather than a reason to abort.
	indir=$(dirname -- "$in")
	if [ -d "$indir" ]; then
		for sibling in "$indir"/* "$indir"/.[!.]*; do
			[ -e "$sibling" ] || continue
			name=$(basename -- "$sibling")
			case $name in
				"$leaf.html"|"$leaf.pdf") continue ;;
			esac
			# `if` rather than `[ ... ] && continue`: under set -e a
			# bare test as the last command of the loop body fails the
			# whole loop when it is false.
			if [ ! -e "$WORK/$name" ]; then
				ln -s -- "$sibling" "$WORK/$name" 2>/dev/null || true
			fi
		done
	fi
fi

# --- markdown_features -------------------------------------------------------
#
# A document may change the dialect it is written in, using pandoc's own
# extension grammar. Three forms, and the difference is whether a base is named:
#
#   markdown_features: -smart                 RELATIVE -- PFM, minus smart
#   markdown_features: commonmark_x-smart     ABSOLUTE -- exactly this
#   (absent)                                  PFM as-is
#
# A value starting with `+` or `-` is relative and is appended to PFM_FORMAT;
# anything else names its own base and replaces it. The value is then passed to
# -f untouched rather than parsed into parts: the grammar is pandoc's, so
# pandoc validates it and names the offending extension when it is wrong.
#
# READ FROM THE SIDECAR ONLY. The wrapper splits every document's frontmatter
# into a .yaml beside the body before this runs (lib/frontmatter.sh), so by the
# time the engine sees a document there is nothing left inside it to scan --
# and a document reaching this engine WITHOUT the wrapper has no payload and no
# theme either, so it is not a case this key needs to work in.
#
# An earlier version scanned the document too, with a sed expression that had
# to be anchored to line 1 (or a horizontal rule three paragraphs down started
# a metadata block) and whose closing brace had to sit on its own line (or BSD
# sed rejected it, while the container's GNU sed did not). Both traps went away
# with the scan: the wrapper does this once now, for every engine, and this
# reads a single key out of a file that holds nothing else.
#
# Still not a YAML parser, deliberately. The value has to be known in order to
# BUILD the pandoc command line, so it cannot wait for pandoc to parse the
# metadata -- but it is one scalar on one line, which is the only thing here
# that needs reading before the fact.
mf=""
if [ "$in" != "-" ]; then
	for ext in yaml yml; do
		if [ -f "${in%.*}.$ext" ]; then
			mf=$(sed -n 's/^markdown_features:[[:space:]]*//p' \
				"${in%.*}.$ext" | head -1)
			break
		fi
	done
fi

mf=$(printf '%s' "$mf" | tr -d '\r' | sed 's/[[:space:]]*$//')

# Strip surrounding quotes: `markdown_features: "-smart"` is ordinary YAML.
case $mf in
	\"*\") mf=${mf#\"}; mf=${mf%\"} ;;
	"'"*"'") mf=${mf#"'"}; mf=${mf%"'"} ;;
esac

if [ -n "$mf" ]; then
	case $mf in
		+*|-*) FORMAT="$PFM_FORMAT$mf" ;;
		*)     FORMAT="$mf" ;;
	esac
fi

# Markdown -> HTML.
#
# --no-highlight because the stylesheet does its own code styling; pandoc's
# inline highlighting would fight it with hardcoded colours.
# shellcheck disable=SC2086
pandoc "$SOURCE" \
	-f "$FORMAT" \
	$METADATA \
	$FILTERS \
	$CSSVARS \
	--template="$TEMPLATE" \
	--no-highlight \
	-t html5 \
	-o "$WORK/$leaf.html"

# HTML -> PDF.
#
# The browser flags are not optional in a container: --no-sandbox because
# Chromium's sandbox needs privileges a default `docker run` does not grant,
# and --disable-dev-shm-usage because /dev/shm defaults to 64MB, which a
# paginating renderer exhausts on a document of any size -- producing a crash
# that reads as a Paged.js failure rather than as a full filesystem.
#
# Written to the scratch directory and moved, so an interrupted run cannot
# leave a half-written PDF that still looks like one.
pagedjs-cli \
	-i "$WORK/$leaf.html" \
	-o "$WORK/$leaf.pdf" \
	--browserArgs "--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage" \
	>&2

if [ "$out" = "-" ]; then
	cat "$WORK/$leaf.pdf"
else
	outdir=$(dirname -- "$out")
	[ -d "$outdir" ] || mkdir -p -- "$outdir"
	# mv across a bind mount is a copy, and rename(2) cannot cross
	# filesystems -- the same EXDEV that bit the vivlio engine (7ef0319).
	# `mv` handles the fallback itself, which is why this is not a rename.
	mv -- "$WORK/$leaf.pdf" "$out"
fi
