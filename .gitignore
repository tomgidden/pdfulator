.claude
.DS_Store
.vscode
/tmp
._*
.#*
*.bak
*.old
*.md
*.pdf
!README.md

# Note, the PDF wouldn't usually be included, but as it's uniquely part of
# pdf generation instruction, it's included as example.
!README.pdf

node_modules/
# bun.lock IS tracked, for both markdown-it engines: the vivlio-docker image
# builds with `bun install --frozen-lockfile`, so a stale lockfile fails the
# build rather than silently resolving something else. Change a package.json
# here and you must re-run `bun install` and commit the lockfile with it.
#
# package-lock.json is the npm byproduct of doing that work with the wrong
# tool. It is ignored so it cannot be committed alongside bun.lock, where two
# lockfiles would be free to disagree.
package-lock.json
pdfulator.tar.gz
pdfulator.tar.gz.sha256
.dist/

.version

# Runtime state, written when PDFULATOR_HOME points at a working tree rather
# than an installed copy -- which is what running from source does. lib/paths.sh
# and lib/engines.sh put the staged payload cache and the per-engine "already
# prepared" marks here, and `.engine` records the last engine used.
.engine
.prepared/
cache/

# The markdown-it pagedjs engine writes its generated HTML beside the source
# document -- pagedjs-cli resolves relative hrefs against the file's own
# location, so a temp directory would break every relative image. It is
# removed after each run, and kept deliberately by `--debug`.
.pdfulator-*.html
